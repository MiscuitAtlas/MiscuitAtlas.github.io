---
import Base from '../layouts/Base.astro';
---

<Base titre="Page introuvable" description="Cette page n’existe pas.">
    <section class="container not-found">
        <p class="code">ldap_search: No such object (32)</p>
        <h1>Page introuvable</h1>
        <p class="lead">Cette adresse ne correspond à aucune page du site. Elle a peut-être été déplacée lors de la refonte.</p>
        <div class="btn-group">
            <a class="btn btn-primary" href="/">Revenir à l’accueil</a>
            <a class="btn btn-secondary" href="/#projets">Voir les projets</a>
        </div>
    </section>
</Base>

<style>
    .not-found {
        display: grid;
        gap: var(--space-5);
        padding-block: var(--space-9);
        max-width: 44rem;
        margin-inline: auto;
    }

    .code {
        font-family: var(--font-mono);
        color: var(--accent);
    }

    .lead {
        font-size: var(--step-1);
        color: var(--text-muted);
    }
</style>
