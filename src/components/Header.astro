---
import Icon from './Icon.astro';

const liens = [
    { href: '/#projets', texte: 'Projets' },
    { href: '/#parcours', texte: 'Parcours' },
    { href: '/#competences', texte: 'Compétences' },
    { href: '/#contact', texte: 'Contact' },
];
---

<header class="site-header">
    <div class="container bar">
        <a class="wordmark" href="/" aria-label="Maxence Français, accueil">~/maxence-francais</a>
        <nav aria-label="Navigation principale">
            <ul>
                {liens.map((lien) => <li><a href={lien.href}>{lien.texte}</a></li>)}
            </ul>
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Passer en mode clair">
            <Icon name="sun" class="icon-sun" />
            <Icon name="moon" class="icon-moon" />
        </button>
    </div>
</header>

<script>
    const root = document.documentElement;
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

    const currentTheme = () => (root.dataset['theme'] === 'light' ? 'light' : 'dark');

    const updateLabel = () => {
        button?.setAttribute('aria-label', currentTheme() === 'light' ? 'Passer en mode sombre' : 'Passer en mode clair');
    };

    button?.addEventListener('click', () => {
        const next = currentTheme() === 'light' ? 'dark' : 'light';
        root.dataset['theme'] = next;
        try {
            localStorage.setItem('theme', next);
        } catch {
            // Stockage indisponible (navigation privée stricte) : le choix vaut pour la page en cours.
        }
        updateLabel();
    });

    updateLabel();
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line-soft);
    }

    .bar {
        display: flex;
        align-items: center;
        gap: var(--space-5);
        min-height: 4rem;
    }

    .wordmark {
        font-family: var(--font-mono);
        font-weight: 500;
        color: var(--text);
        text-decoration: none;
        margin-right: auto;
        white-space: nowrap;
    }

    .wordmark:hover {
        color: var(--accent);
    }

    nav ul {
        display: flex;
        gap: var(--space-5);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: var(--step--1);
        font-weight: 500;
    }

    nav a:hover {
        color: var(--text);
    }

    .theme-toggle {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
        background: transparent;
        color: var(--text);
        cursor: pointer;
    }

    .theme-toggle:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .theme-toggle :global(svg) {
        width: 1.1rem;
        height: 1.1rem;
    }

    /* Mode sombre : on propose le soleil ; mode clair : la lune */
    :global([data-theme='light']) .theme-toggle :global(.icon-sun),
    .theme-toggle :global(.icon-moon) {
        display: none;
    }

    :global([data-theme='light']) .theme-toggle :global(.icon-moon) {
        display: block;
    }

    @media (max-width: 40rem) {
        .bar {
            flex-wrap: wrap;
            gap: var(--space-3) var(--space-4);
            padding-block: var(--space-3);
        }

        nav {
            order: 3;
            width: 100%;
            overflow-x: auto;
        }

        nav ul {
            gap: var(--space-4);
        }
    }
</style>
