---
/**
 * Vignette illustrative du projet « Suivi du sommeil » (pas de capture d'écran disponible) :
 * une semaine de cycles de sommeil avec le seuil de 5 cycles utilisé par l'application.
 * Valeurs d'exemple, purement décoratives.
 */
const cycles = [4.5, 5.2, 5.6, 3.8, 5.1, 6.0, 5.4];
const hauteurMax = 7;
---

<svg class="sleep-thumb" viewBox="0 0 160 100" role="img" aria-label="Illustration : cycles de sommeil sur une semaine">
    <rect class="bg" width="160" height="100" />
    <line class="seuil" x1="12" x2="148" y1={88 - (5 / hauteurMax) * 70} y2={88 - (5 / hauteurMax) * 70} />
    {
        cycles.map((c, i) => (
            <rect
                class={c >= 5 ? 'barre ok' : 'barre'}
                x={16 + i * 19}
                y={88 - (c / hauteurMax) * 70}
                width="11"
                height={(c / hauteurMax) * 70}
                rx="1.5"
            />
        ))
    }
</svg>

<style>
    .sleep-thumb {
        display: block;
        width: 100%;
        height: 100%;
    }

    .bg {
        fill: var(--surface-raised);
    }

    .seuil {
        stroke: var(--text-muted);
        stroke-width: 0.6;
        stroke-dasharray: 2 2;
    }

    .barre {
        fill: var(--bar-muted);
    }

    .barre.ok {
        fill: var(--accent-strong);
    }
</style>
