---
/**
 * Fiche de présentation au format d'une entrée d'annuaire LDAP (LDIF),
 * clin d'œil à l'expérience IAM / Active Directory.
 */
import { Image } from 'astro:assets';
import photo from '../assets/profil/photo.png';
import { profil } from '../data/profil';
---

<figure class="record" aria-label="Fiche de présentation">
    <div class="record-lines">
        <p class="line dn"><span class="key">dn:</span> <span class="value">{profil.dn}</span></p>
        <dl>
            {
                profil.attributs.map((attribut) => (
                    <div class="line">
                        <dt class="key">{attribut.cle}:</dt>
                        <dd class="value">
                            {attribut.valeur}
                            {'disponible' in attribut && attribut.disponible && (
                                <span class="status">
                                    <span class="status-dot" aria-hidden="true" /> disponible
                                </span>
                            )}
                        </dd>
                    </div>
                ))
            }
        </dl>
    </div>
    <div class="record-photo">
        <Image
            src={photo}
            alt={`Photo de ${profil.nom}`}
            widths={[160, 320]}
            sizes="160px"
            loading="eager"
            fetchpriority="high"
        />
        <span class="photo-key">jpegPhoto</span>
    </div>
</figure>

<style>
    .record {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: var(--space-6);
        margin: 0;
        padding: var(--space-6);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow);
        font-family: var(--font-mono);
        font-size: 0.95rem;
        line-height: 1.55;
    }

    dl {
        margin: 0;
    }

    .line {
        display: grid;
        grid-template-columns: 8.5rem 1fr;
        gap: var(--space-3);
        padding-block: 0.3rem;
    }

    .dn {
        grid-template-columns: 2.5rem 1fr;
        padding-bottom: var(--space-3);
        margin-bottom: var(--space-2);
        border-bottom: 1px dashed var(--line);
        color: var(--text-muted);
        overflow-wrap: anywhere;
    }

    .key {
        color: var(--accent);
    }

    dd {
        margin: 0;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-left: 0.5rem;
        color: var(--signal);
        white-space: nowrap;
    }

    .status-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--signal);
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 60%, transparent);
    }

    .record-photo {
        display: grid;
        justify-items: center;
        align-content: start;
        gap: var(--space-2);
    }

    .record-photo img {
        width: 160px;
        aspect-ratio: 1;
        object-fit: cover;
        object-position: 50% 18%;
        border-radius: var(--radius-s);
        border: 1px solid var(--line);
        filter: saturate(0.9);
    }

    .photo-key {
        font-size: var(--step--1);
        color: var(--accent);
    }

    /* Moment d'animation unique : les attributs de la fiche s'affichent ligne par ligne */
    @media (prefers-reduced-motion: no-preference) {
        .line {
            animation: line-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }

        dl .line:nth-child(1) { animation-delay: 0.12s; }
        dl .line:nth-child(2) { animation-delay: 0.22s; }
        dl .line:nth-child(3) { animation-delay: 0.32s; }
        dl .line:nth-child(4) { animation-delay: 0.42s; }
        dl .line:nth-child(5) { animation-delay: 0.52s; }

        .status-dot {
            animation: pulse 2.4s ease-out 1.2s infinite;
        }
    }

    @keyframes line-in {
        from {
            opacity: 0;
            transform: translateX(-6px);
        }
    }

    @keyframes pulse {
        70% {
            box-shadow: 0 0 0 0.45rem color-mix(in srgb, var(--signal) 0%, transparent);
        }
        100% {
            box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 0%, transparent);
        }
    }

    @media (max-width: 46rem) {
        .record {
            grid-template-columns: 1fr;
            padding: var(--space-5);
            font-size: 0.875rem;
        }

        .record-photo {
            order: -1;
            justify-items: start;
            grid-template-columns: auto 1fr;
            align-items: end;
        }

        .record-photo img {
            width: 88px;
        }

        .line {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .dn {
            grid-template-columns: 1fr;
        }
    }
</style>
